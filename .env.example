# Copy this file to .env and fill in real values. Never commit the real .env.

# Standard connection string (SRV) to your Atlas cluster.
# Use a user with readWrite on the demo database plus dbAdmin (for index/setQuerySettings commands).
ATLAS_URI=mongodb+srv://<user>:<password>@<cluster-host>/?retryWrites=true&w=majority

# Atlas Admin API keys — only needed if you want to trigger Test Failover / read
# Performance Advisor programmatically instead of clicking through the Atlas UI.
# Project role required: Project Cluster Manager (or Project Owner).
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

# Database/collection names used by all notebooks in this folder.
DEMO_DB=amex_demo

# Module 2 (analytics): how many synthetic money-movement docs to generate.
# Default keeps a live demo fast; crank this up to see it scale further.
TRANSACTION_COUNT=200000

# Queryable Encryption bonus notebook: path to the Automatic Encryption
# Shared Library (crypt_shared), downloaded from the MongoDB Download Center.
# macOS example: /usr/local/lib/mongo_crypt_v1.dylib
# Linux example:  /usr/local/lib/mongo_crypt_v1.so
CRYPT_SHARED_LIB_PATH=
