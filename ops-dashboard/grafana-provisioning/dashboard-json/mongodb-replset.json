{
  "title": "MongoDB ReplSet — Ops Dashboard",
  "uid": "amex-mongo-replset",
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "table",
      "title": "Replica Set Member State",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "mongodb_members_state", "format": "table", "instant": true, "refId": "A" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "This Node's State (1=PRIMARY, 2=SECONDARY)",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "mongodb_myState", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "1": { "text": "PRIMARY", "color": "green" } } },
            { "type": "value", "options": { "2": { "text": "SECONDARY", "color": "blue" } } }
          ]
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Replication Staleness per Member (seconds)",
      "description": "time() minus each member's last-applied optime. Watch this spike briefly during Test Failover.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "targets": [
        { "expr": "time() - (mongodb_members_optimeDate/1000)", "legendFormat": "{{member_idx}} ({{member_state}})", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Connections",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "targets": [
        { "expr": "mongodb_ss_connections{conn_type=\"current\"}", "legendFormat": "current", "refId": "A" },
        { "expr": "mongodb_ss_connections{conn_type=\"available\"}", "legendFormat": "available", "refId": "B" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Op Counters (rate/sec, by type)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "targets": [
        { "expr": "rate(mongodb_ss_opcounters[1m])", "legendFormat": "{{legacy_op_type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Resident Memory (MB)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "targets": [
        { "expr": "mongodb_ss_mem_resident", "legendFormat": "resident MB", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes" }, "overrides": [] }
    }
  ]
}
